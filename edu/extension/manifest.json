{
  "manifest_version": 3,
  "name": "KinoDraw for Classroom",
  "short_name": "KinoDraw",
  "version": "0.1.0",
  "description": "Turn your lesson script into a hand-drawn video for your class, made in Chrome and posted to Google Classroom.",
  "minimum_chrome_version": "124",
  "key": "",
  "icons": { "128": "icons/icon128.png", "48": "icons/icon48.png", "16": "icons/icon16.png" },
  "action": { "default_title": "KinoDraw for Classroom" },
  "permissions": ["identity", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://classroom.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://api.doodlecloud.org/*",
    "https://huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "background": { "service_worker": "sw.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://classroom.google.com/*"], "js": ["content/classroom.js"], "css": ["content/classroom.css"], "run_at": "document_idle" }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';" },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" }
}
